# ============================================================
# MCP Server for RAG — Environment Variables
# ============================================================
# Copy file này thành .env và điền giá trị thật:
#   cp .env.example .env
#
# Tạo JWT_SECRET an toàn:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# ============================================================

# ----- App -----
APP_NAME=mcp-server-rag
APP_VERSION=1.0.0
ENVIRONMENT=development
LOG_LEVEL=INFO

# ----- Auth (BẮT BUỘC) -----
# Ít nhất 32 ký tự. KHÔNG dùng giá trị mặc định trong production.
JWT_SECRET=your-super-secret-key-at-least-32-characters-long
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=30

# ----- Database -----
DATABASE_URL=postgresql+asyncpg://mcp_user:mcp_password@localhost:5432/mcp_rag
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# ----- Redis -----
REDIS_URL=redis://localhost:6379/0

# ----- RAG Engine -----
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
CHUNK_SIZE=512
CHUNK_OVERLAP=50
TOP_K=10
RERANK_TOP_K=5

# ----- CRAG -----
CRAG_ENABLED=true
CRAG_CORRECT_THRESHOLD=0.8
CRAG_INCORRECT_THRESHOLD=0.3

# ----- LLM (Optional — để trống nếu chỉ search) -----
ANTHROPIC_API_KEY=
LLM_MODEL=claude-3-5-sonnet-20241022
LLM_MAX_TOKENS=2048
LLM_TEMPERATURE=0.0

# ----- Security -----
RATE_LIMIT_PER_MINUTE=60
MAX_QUERY_LENGTH=500
MAX_TOP_K=50
